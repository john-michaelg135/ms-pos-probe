# ============================================================
# POS-PROBE dashboard — PRODUCTION env (set these in Vercel)
# ============================================================

# Deployed POS-PROBE gateway base URL (Render). No trailing slash.
# Example: https://pos-probe-gateway.onrender.com
NEXT_PUBLIC_API_URL=

# WebSocket URL for live alerts — same host as the gateway, wss scheme.
# Example: wss://pos-probe-gateway.onrender.com
NEXT_PUBLIC_WS_URL=

# Same value as PROBE_HANDOFF_SECRET in the POS; sign-in arrives from the POS "Open Probe" button
PROBE_HANDOFF_SECRET=
# Deployed POS address (for "Back to POS" and after logging out)
NEXT_PUBLIC_POS_URL=
