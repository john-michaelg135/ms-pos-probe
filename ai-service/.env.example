# ============================================
# POS-PROBE AI Service Configuration
# ============================================

# FastAPI Server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ── Legacy PostgreSQL (READ-ONLY access) ──
# This is the Capstone 1 operational database. We only READ from it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=pos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ── Redis (Memurai on Windows) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_HOURS=6

# ── DuckDB (OLAP file-based database) ──
DUCKDB_PATH=./data/analytics.duckdb

# ── APScheduler Sync Configuration ──
# How often (in minutes) to sync from PostgreSQL → DuckDB
SYNC_INTERVAL_MINUTES=10

# ── Machine Learning Configuration ──
# Isolation Forest contamination rate (expected proportion of anomalies)
CONTAMINATION_RATE=0.05

# Prophet forecast cache TTL in seconds (6 hours = 21600)
FORECAST_CACHE_TTL=21600

# ── JWT Authentication ──
# Secret key used by the legacy auth service to sign JWTs
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256

# ============================================
# PRODUCTION / HOSTED overrides (Neon + Upstash)
# ============================================

# ── Hosted PostgreSQL (Neon/Supabase) ──
# POSTGRES_HOST=ep-xxx.neon.tech
# POSTGRES_PORT=5432
# POSTGRES_DB=pos_db
# POSTGRES_USER=your_user
# POSTGRES_PASSWORD=your_password
# Neon requires SSL:
# POSTGRES_SSLMODE=require

# ── Hosted Redis (Upstash) ──
# Set the full connection string; it overrides REDIS_HOST/PORT/PASSWORD/SSL.
# REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379

# ── CORS (comma-separated deployed origins) ──
# ALLOWED_ORIGINS=https://pos-probe-dashboard.vercel.app,https://pos-probe-gateway.onrender.com
