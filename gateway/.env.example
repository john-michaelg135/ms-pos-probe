# ============================================
# POS-PROBE YARP Gateway Configuration
# ============================================

# The original Capstone 1 API Gateway URL (DO NOT MODIFY the legacy gateway itself)
LEGACY_GATEWAY_URL=http://localhost:5001

# The Python FastAPI AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Port this gateway listens on (frontends will point here after cutover)
GATEWAY_PORT=5020

# CORS: Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3004,http://localhost:3006

# Logging level (Information, Warning, Error, Debug)
LOG_LEVEL=Information
