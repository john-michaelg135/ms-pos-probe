# ============================================
# POS-PROBE Monorepo .gitignore
# ============================================

# ── Documentation (allow docs to be tracked) ──
# NOTE: Removed the *docs rule that was ignoring the docs/ folder

# ── Global ──
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp

# ── Environment Variables ──
.env
.env.local
.env.*.local

# ── IDE ──
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ============================================
# Gateway (C# .NET / YARP)
# ============================================
gateway/bin/
gateway/obj/
gateway/*.user
gateway/*.suo

# ── .NET build artifacts ──
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.dll
*.exe
*.pdb
*.cache

# ============================================
# AI Service (Python / FastAPI)
# ============================================
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/.pytest_cache/
ai-service/.mypy_cache/
ai-service/.ruff_cache/
ai-service/venv/
ai-service/.venv/
ai-service/*.egg-info/
ai-service/dist/
ai-service/build/

# ── DuckDB database files ──
ai-service/data/*.duckdb
ai-service/data/*.duckdb.wal

# ── ML model artifacts (large binary files) ──
ai-service/models/artifacts/*.pkl
ai-service/models/artifacts/*.joblib

# ── Python general ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg

# ============================================
# Dashboard (Next.js / React)
# ============================================
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/build/
dashboard/.pnp
dashboard/.pnp.js
dashboard/coverage/
dashboard/*.tsbuildinfo
dashboard/next-env.d.ts

# ── npm/yarn/pnpm ──
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Docker & Infrastructure
# ============================================
docker/volumes/
docker/data/

# ── Redis dump ──
dump.rdb

# Local
*docs